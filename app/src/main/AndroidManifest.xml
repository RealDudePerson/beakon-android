<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions are limited to exactly the set required by the spec.
      RECEIVE_BOOT_COMPLETED powers the opt-in "Start tracking at boot" setting.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held only for the duration of one tracking tick (location fix + POST). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BeakonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beakon">

        <!--
          singleTask: a notification tap must bring the existing instance to the
          front instead of stacking another MainActivity. See NotificationHelper.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          System broadcast, so exported="true" is required and correct. The
          filter lists BOOT_COMPLETED only. Not directBootAware: credentials are
          in credential-encrypted storage, unavailable before first unlock.
        -->
        <receiver
            android:name=".tracking.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Location-sharing widget. exported="false": only the app and the system
          widget host should reach it, and the provider does nothing but schedule
          WidgetWorker and refresh its own RemoteViews.
        -->
        <receiver
            android:name=".widget.BeakonWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/beakon_widget_info" />
        </receiver>

        <!--
          Placement-time configuration (D1). The launcher starts it to choose the
          person a widget is pinned to, so it must be reachable from the launcher
          (a different app): exported="true". It exposes no data and writes only
          the chosen username into the app's own preferences.
        -->
        <activity
            android:name=".widget.BeakonWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
